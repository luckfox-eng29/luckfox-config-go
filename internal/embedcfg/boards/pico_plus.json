{
  "id": "pico_plus",
  "chip": "rv1106",
  "config_mode": "normal",
  "pinctrl_naming": "v1",
  "split_spi": true,
  "model_strings": ["Luckfox Pico Plus"],
  "boot_media": {
    "mmc": "/dev/mmcblk1p4",
    "nand": "/dev/mtdblock3"
  },
  "features": {
    "has_4g_module": false,
    "has_fbtft": true,
    "usb_node": "/usbdrd/usb@ffb00000",
    "csi_unite_node": "/rkisp@ffa00000",
    "csi_bus_node": "/i2c@ff470000",
    "has_sdmmc": true
  },
  "reserved_pins": [],
  "pin_diagram": [
    "                                 Luckfox_Pico_Plus",
    "                                     + -USB- +",
    "          - FIQtty_TX     - GPIO1_B2 |       | VBUS     -             -",
    "          - FIQtty_RX     - GPIO1_B3 |       | VSYS     -             -",
    "          -               -      GND |       | GND      -             -",
    " PWM11_M1 - UART4_M1_CTS  - GPIO1_C7 |       | 3V3_EN   -             -",
    " PWM10_M1 - UART4_M1_RTS  - GPIO1_C6 |       | 3V3_OUT  -             -",
    " PWM9_M1  - UART4_M1_TX   - GPIO1_C5 |       | NC       -             -",
    " PWM8_M1  - UART4_M1_RX   - GPIO1_C4 |       | NC       -             -",
    "          -               -      GND |       | GND      -             -",
    " PWM0_M1  - I2C3_M1_SDA   - GPIO1_D2 |       | GPIO4_C1 - SARADC_M1   -",
    " PWM11_M2 - I2C3_M1_SCL   - GPIO1_D3 |       | GPIO4_C0 - SARADC_M0   -",
    " PWM0_M0  -               - GPIO1_A2 |       | NC       -             -",
    " PWM2_M2  - SPI0_M0_CS0   - GPIO1_C0 |       | GPIO3_A1 -             -",
    "          -               -      GND |       | GND      -             -",
    " PWM4_M2  - SPI0_M0_CLK   - GPIO1_C1 |       | GPIO3_A3 -             - PWM8_M0",
    " PWM5_M2  - SPI0_M0_MOSI  - GPIO1_C2 |       | GPIO3_A2 -             - PWM9_M0",
    " PWM6_M2  - SPI0_M0_MISO  - GPIO1_C3 |       | GPIO3_A4 - I2C0_M2_SCL - PWM10_M0",
    " PWM1_M0  -               - GPIO0_A4 |       | GPIO3_A5 - I2C0_M2_SDA - PWM11_M0",
    "          -               -      GND |       | GND      -             -",
    " PWM3_M2  - UART3_M1_TX   - GPIO1_D0 |       | GPIO3_A7 - UART5_M0_RX -",
    " PWM10_M2 - UART3_M1_RX   - GPIO1_D1 |       | GPIO3_A6 - UART5_M0_TX -",
    "                                     + - + - +"
  ],
  "peripherals": {
    "uart": ["3_M1", "4_M1", "5_M0"],
    "i2c": ["2_M1", "3_M1"],
    "spi": ["0_M0"],
    "pwm": ["11_M1", "10_M1", "9_M1", "8_M1", "0_M1", "11_M2", "0_M0", "2_M2", "4_M2", "5_M2", "6_M2", "1_M0", "3_M2", "10_M2", "8_M0", "9_M0", "10_M0", "11_M0"],
    "compatible_apps": [
      {
        "name": "Pico_LCD",
        "spi": {"cs": true, "miso": false},
        "enable": ["spi0m0"],
        "check": ["pwm11m1", "pwm10m1", "pwm0m0", "pwm2m2", "pwm4m2", "pwm5m2", "pwm6m2", "pwm1m0", "pwm10m2", "uart3m1", "pwm9m0", "pwm11m0", "uart5m0"],
        "gpio": [{"pin": "GPIO1_C6", "pull": "up"}, {"pin": "GPIO1_C7", "pull": "up"}, {"pin": "GPIO1_D1", "pull": "up"}, {"pin": "GPIO3_A6", "pull": "up", "mode": 0}, {"pin": "GPIO3_A7", "pull": "up", "mode": 0}, {"pin": "GPIO3_A5", "pull": "up", "mode": 0}, {"pin": "GPIO3_A2", "pull": "up", "mode": 0}]
      },
      {
        "name": "Pico_ePaper",
        "spi": {"cs": true, "miso": false},
        "enable": ["spi0m0"],
        "check": ["pwm0m0", "pwm2m2", "pwm4m2", "pwm5m2", "pwm6m2", "pwm1m0"]
      },
      {
        "name": "Pico_UPS_B",
        "enable": ["i2c3m1"],
        "check": ["pwm0m1", "pwm11m2"]
      },
      {
        "name": "Pico_ResTouch_LCD",
        "spi": {"cs": false, "miso": true},
        "enable": ["spi0m0"],
        "check": ["pwm8m1", "pwm0m0", "pwm2m2", "pwm1m0", "pwm10m2", "uart3m1", "uart4m1", "uart5m0", "i2c0m2"],
        "gpio": [{"pin": "GPIO1_D1", "pull": "up"}, {"pin": "GPIO3_A7", "pull": "up", "mode": 0}, {"pin": "GPIO3_A6", "pull": "none", "mode": 0}]
      },
      {
        "name": "OLED_Module",
        "spi": {"cs": false, "miso": false},
        "enable": ["spi0m0", "i2c3m1"],
        "check": ["pwm11m1", "pwm10m1", "pwm8m1", "pwm0m1", "pwm11m2", "pwm4m2", "pwm5m2", "uart4m1"]
      },
      {
        "name": "Pico_OLED",
        "spi": {"cs": false, "miso": false},
        "enable": ["spi0m0", "i2c3m1"],
        "check": ["uart3m1", "pwm0m0", "pwm0m1", "pwm11m2", "uart5m0"]
      },
      {
        "name": "DHT11",
        "check": ["pwm11m1"],
        "nodes": [{"path": "/dht11_sensor", "status": "okay"}]
      }
    ],
    "fbtft": {
      "gpio": ["GPIO1_A2", "GPIO0_A4", "GPIO1_C3"],
      "spi": ["SPI0_M0_CS0", "SPI0_M0_CLK", "SPI0_M0_MOSI"]
    }
  }
}
